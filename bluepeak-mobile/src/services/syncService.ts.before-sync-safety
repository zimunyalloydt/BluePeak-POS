import api from "./api";

import {
    getDatabase,
    getActiveOrganisationId,
    markSaleSynced as markLocalSaleSynced,
    markSaleSyncFailed,
} from "./localDatabase";

import {
    getToken,
    getUser,
} from "../storage/authStorage";

interface LocalSale {
    localSaleId: string;
    receiptToken: string | null;
    userId: number;
    paymentMethod: string;
    amountPaid: number;
    customerName: string | null;
    syncStatus: string;
}

interface LocalSaleItem {
    productId: number;
    quantity: number;
}

interface SyncResult {
    localSaleId: string;
    success: boolean;
    serverSaleId?: number;
    error?: string;
}

async function assertActiveOrganisation(): Promise<void> {
    const organisationId = getActiveOrganisationId();
    const user = await getUser();
    const token = await getToken();

    if (!organisationId || !user) {
        throw new Error(
            "No authenticated organisation is selected."
        );
    }

    if (user.organisationId !== organisationId) {
        throw new Error(
            "The authenticated user does not match the active organisation."
        );
    }

    if (!token) {
        throw new Error(
            "An online session is required to synchronize sales."
        );
    }
}

async function getPendingSales(): Promise<LocalSale[]> {
    await assertActiveOrganisation();

    const db = await getDatabase();

    return db.getAllAsync<LocalSale>(
        `
        SELECT
            s.localSaleId,
            s.receiptToken,
            s.userId,
            s.paymentMethod,
            s.amountPaid,
            s.customerName,
            s.syncStatus
        FROM sales s
        INNER JOIN sync_queue q
            ON q.localSaleId = s.localSaleId
        WHERE
            s.syncStatus IN ('pending', 'failed', 'syncing')
            AND q.status IN ('pending', 'failed', 'syncing')
        ORDER BY s.id ASC
        `
    );
}

async function getSaleItems(
    localSaleId: string
): Promise<LocalSaleItem[]> {
    const db = await getDatabase();

    return db.getAllAsync<LocalSaleItem>(
        `
        SELECT productId, quantity
        FROM sale_items
        WHERE localSaleId = ?
        ORDER BY id ASC
        `,
        localSaleId
    );
}

async function markSyncFailedSafely(
    localSaleId: string,
    message: string
): Promise<void> {
    try {
        await markSaleSyncFailed(localSaleId, message);
    } catch (error) {
        console.error(
            `Could not update sync status for ${localSaleId}:`,
            error
        );
    }
}

async function syncOneSale(
    sale: LocalSale
): Promise<SyncResult> {
    try {
        // Recheck immediately before each upload.
        await assertActiveOrganisation();

        const user = await getUser();

        if (!user || user.userId !== sale.userId) {
            throw new Error(
                "The sale belongs to a different user. Automatic synchronization stopped."
            );
        }

        const items = await getSaleItems(sale.localSaleId);

        if (items.length === 0) {
            throw new Error(
                "Local sale has no sale items. Manual review is required."
            );
        }

        const payload = {
            clientSaleId: sale.localSaleId,
            userId: sale.userId,
            receiptToken: sale.receiptToken,
            paymentMethod: sale.paymentMethod,
            amountPaid: sale.amountPaid,
            customerName: sale.customerName ?? undefined,
            items: items.map((item) => ({
                productId: item.productId,
                quantity: item.quantity,
            })),
        };

        console.log(
            `Synchronizing local sale ${sale.localSaleId}...`
        );

        const response = await api.post<{
            saleId: number;
            message: string;
        }>("/Sales", payload);

        const serverSaleId = response.data.saleId;

        if (
            !Number.isInteger(serverSaleId) ||
            serverSaleId <= 0
        ) {
            throw new Error(
                "The server response did not contain a valid sale ID."
            );
        }

        // Confirm that the selected organisation has not changed.
        await assertActiveOrganisation();

        await markLocalSaleSynced(
            sale.localSaleId,
            serverSaleId
        );

        return {
            localSaleId: sale.localSaleId,
            success: true,
            serverSaleId,
        };
    } catch (error: any) {
        const status = error?.response?.status;

        const responseMessage =
            error?.response?.data?.message;

        const message = String(
            responseMessage ??
            error?.message ??
            "Unknown synchronization error."
        );

        /*
         * Never automatically reject or restore stock merely
         * because the server returned an error.
         *
         * Authentication errors stop the whole sync batch.
         * Other failures remain available for retry/manual review.
         */
        await markSyncFailedSafely(
            sale.localSaleId,
            message
        );

        if (status === 401 || status === 403) {
            console.warn(
                "Authentication/permission error. Sync must stop."
            );
        }

        return {
            localSaleId: sale.localSaleId,
            success: false,
            error: message,
        };
    }
}

export async function syncPendingSales(): Promise<SyncResult[]> {
    await assertActiveOrganisation();

    const pendingSales = await getPendingSales();

    if (pendingSales.length === 0) {
        console.log("No pending sales to synchronize.");
        return [];
    }

    console.log(
        `Found ${pendingSales.length} sale(s) waiting for synchronization.`
    );

    const results: SyncResult[] = [];

    for (const sale of pendingSales) {
        // Prevent uploading into another organisation if the user
        // switches accounts while this batch is running.
        try {
            await assertActiveOrganisation();
        } catch (error: any) {
            console.warn(
                "Stopping synchronization:",
                error?.message ?? error
            );
            break;
        }

        const result = await syncOneSale(sale);

        results.push(result);

        if (!result.success) {
            console.warn(
                "Stopping the batch after a synchronization failure."
            );
            break;
        }
    }

    const successful = results.filter(
        (result) => result.success
    ).length;

    console.log(
        `Sync finished: ${successful}/${results.length} sale(s) synchronized.`
    );

    return results;
}

export async function getPendingSaleCount(): Promise<number> {
    await assertActiveOrganisation();

    const db = await getDatabase();

    const result = await db.getFirstAsync<{
        count: number;
    }>(
        `
        SELECT COUNT(*) AS count
        FROM sync_queue
        WHERE status IN ('pending', 'failed', 'syncing')
        `
    );

    return Number(result?.count ?? 0);
}
