import React, {
    createContext,
    useContext,
    useEffect,
    useState,
} from "react";

import {
    clearAuth,
    getToken,
    getUser,
    saveAuth,
    saveOfflineAuth,
    verifyOfflineLogin,
    type StoredAuthUser,
} from "../storage/authStorage";

import { login as apiLogin } from "../services/authService";

export type User = StoredAuthUser;

type AuthContextType = {
    user: User | null;
    token: string | null;
    loading: boolean;
    login: (
        organisationCode: string,
        username: string,
        password: string
    ) => Promise<User>;
    logout: () => Promise<void>;
};

const AuthContext = createContext<AuthContextType | undefined>(
    undefined
);

export function AuthProvider({
    children,
}: {
    children: React.ReactNode;
}) {
    const [user, setUser] = useState<User | null>(null);
    const [token, setToken] = useState<string | null>(null);
    const [loading, setLoading] = useState(true);

    useEffect(() => {
        void restoreSession();
    }, []);

    const restoreSession = async () => {
        try {
            const storedToken = await getToken();
            const storedUser = await getUser();

            if (storedToken && storedUser) {
                setToken(storedToken);
                setUser(storedUser);
            }
        } catch (error) {
            console.error("Failed to restore session:", error);
        } finally {
            setLoading(false);
        }
    };

    const login = async (
        organisationCode: string,
        username: string,
        password: string
    ): Promise<User> => {
        const normalisedCode = organisationCode.trim().toUpperCase();
        const normalisedUsername = username.trim();

        if (!normalisedCode || !normalisedUsername || !password) {
            throw new Error(
                "Organisation code, username and password are required."
            );
        }

        try {
            console.log(
                `🔐 Attempting online login for organisation ${normalisedCode}...`
            );

            const result = await apiLogin(
                normalisedUsername,
                password,
                normalisedCode
            );

            const userData: User = {
                userId: result.userId,
                fullName: result.fullName,
                username: result.username,
                role: result.role,
                permissions: result.permissions ?? [],
                organisationId: result.organisationId,
                organisationName: result.organisationName,
                organisationCode: result.organisationCode,
            };

            // Persist the successful online session and its organisation.
            await saveAuth(result.token, userData);

            // Cache credentials separately for this organisation/account.
            await saveOfflineAuth(
                normalisedUsername,
                password,
                userData
            );

            setToken(result.token);
            setUser(userData);

            console.log(
                `✅ Online login successful: ${userData.organisationName}`
            );

            return userData;
        } catch (error: any) {
            /*
             * An HTTP response means the server received the request.
             * Invalid credentials, inactive accounts, and unknown
             * organisations must not be bypassed using offline login.
             */
            if (error?.response) {
                console.log(
                    "❌ Server rejected login:",
                    error.response.status
                );

                throw error;
            }

            console.log(
                `📴 Network unavailable. Checking cached access for ${normalisedCode}...`
            );

            const offlineUser = await verifyOfflineLogin(
                normalisedCode,
                normalisedUsername,
                password
            );

            if (!offlineUser) {
                throw new Error(
                    "You are offline, and no matching offline account was found for this organisation."
                );
            }

            /*
             * Never reuse the previous session's token for a different
             * organisation. Offline sales remain local until an online
             * authenticated session is available.
             */
            await clearAuth();

            setToken(null);
            setUser(offlineUser);

            console.log(
                `✅ Offline login successful: ${offlineUser.organisationName}`
            );

            return offlineUser;
        }
    };

    const logout = async () => {
        await clearAuth();
        setToken(null);
        setUser(null);
    };

    return (
        <AuthContext.Provider
            value={{
                user,
                token,
                loading,
                login,
                logout,
            }}
        >
            {children}
        </AuthContext.Provider>
    );
}

export function useAuth() {
    const context = useContext(AuthContext);

    if (!context) {
        throw new Error("useAuth must be used inside AuthProvider");
    }

    return context;
}
